<?xml version="1.0" encoding="utf-8"?>
<!-- The OpenXR runtime bridge. XR Store assembles the real APK on each Station from this
     skeleton plus the Station's own Rokid runtime (see app/.../BridgeBuilder.java), and
     sets versionCode there. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.wbrooks88.xrstore.bridge" android:versionCode="1" android:versionName="1">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="33" />
    <application android:label="XR Store OpenXR bridge" android:hasCode="false" android:extractNativeLibs="true">
        <service android:name="io.github.wbrooks88.xrstore.bridge.RuntimeService" android:exported="true">
            <meta-data android:name="org.khronos.openxr.OpenXRRuntime.SoFilename" android:value="librokidxrbridge.so" />
            <meta-data android:name="org.khronos.openxr.OpenXRRuntime.MajorVersion" android:value="1" />
            <intent-filter>
                <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
            </intent-filter>
        </service>
    </application>
</manifest>
